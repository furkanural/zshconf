#compdef portkill portprocess
# Listening TCP ports, described by the owning command.

(( CURRENT == 2 )) || return 1
(( $+commands[lsof] )) || return 1

local line cmd
local -a ports
for line in ${(f)"$(_call_program ports lsof -nP -iTCP -sTCP:LISTEN -Fcn 2>/dev/null)"}; do
  case $line in
    c*) cmd=${line#c} ;;
    n*) ports+=("${line##*:}:${cmd}") ;;
  esac
done
ports=(${(u)ports})   # IPv4 + IPv6 dedup

_describe -t ports 'listening port' ports
